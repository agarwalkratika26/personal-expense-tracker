# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/
.uv_python/

# Testing and coverage caches
.pytest_cache/
.coverage
htmlcov/

# Local databases and SQLite stores
data/*.db
data/*.sqlite*
*.db
*.sqlite3

# Environment variables and secrets
.env
.env.local
.env.*.local
.streamlit/secrets.toml
.streamlit/credentials.toml

# Generated runtime outputs
outputs/*
!outputs/.gitkeep

# Generated reports (preserve example template)
reports/*
!reports/.gitkeep
!reports/examples/
reports/examples/*
!reports/examples/expense-report-2026-01.csv

# Operating system artifacts
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.log
